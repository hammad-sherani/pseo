# Leave unset to serve pages from the in-repo seed dataset (src/db/seed-data.ts).
DATABASE_URL=postgres://user:pass@localhost:5432/pseo
SITE_URL=http://localhost:3000
# Public email shown on /contact (e.g. hello@yourdomain.com).
CONTACT_EMAIL=
REVALIDATE_SECRET=change-me
# Google AdSense. Leave the client empty to keep ads (and /ads.txt) off entirely.
# Publisher id, e.g. ca-pub-1234567890123456. Redeploy after changing these.
NEXT_PUBLIC_ADSENSE_CLIENT=
# One AdSense ad unit id per position; an empty id hides that slot.
NEXT_PUBLIC_AD_SLOT_BELOW_TOOL=
NEXT_PUBLIC_AD_SLOT_IN_CONTENT=
NEXT_PUBLIC_AD_SLOT_RAIL=
NEXT_PUBLIC_AD_SLOT_END=
# Used by the content pipeline (npm run pipeline). Never commit a real key; .env is git-ignored.
ANTHROPIC_API_KEY=
