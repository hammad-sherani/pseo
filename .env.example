# Leave unset to serve pages from the in-repo seed dataset (src/db/seed-data.ts).
DATABASE_URL=postgres://user:pass@localhost:5432/pseo
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
# Used by the content pipeline (npm run pipeline). Never commit a real key; .env is git-ignored.
ANTHROPIC_API_KEY=
